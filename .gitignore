# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# open .gitignore and add this line if not already there
.env
.env.test.local

# Supabase CLI cache (machine-specific; stays on disk, not in git)
supabase/.temp/

# Local data backups taken before destructive migrations (may hold personal data)
supabase/backups/

# Throwaway browser scripts. This folder was once committed with real
# passwords in it; nothing in it belongs in git. `npm run check:repo` fails
# if any of it is tracked again.
.tmp-test/

# Android signing keys and the generated Android project (docs/play-store/android-release.md)
*.keystore
*.jks
# Anchored with a leading slash on purpose. Without it, "android/app/" also
# matches mobile/android/app -- the Capacitor module, which is source and must
# be committed. Learned the hard way; see docs/play-store/capacitor-build.md.
/android/keystore.properties
/android/SIGNING-KEY-CREDENTIALS.txt
/android/app/
/android/build/
/android/.gradle/
/android/*.aab
/android/*.apk

# Capacitor shell (mobile/). The android project is source; its outputs are not.
/mobile/node_modules/
/mobile/android/keystore.properties
/mobile/android/local.properties
/mobile/android/.gradle/
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/release/
/mobile/android/capacitor-cordova-android-plugins/build/
